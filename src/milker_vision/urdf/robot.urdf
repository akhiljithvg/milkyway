      <specular>0.5 0.5 0.5 1.0</specular>
    </material>
  </gazebo>
  <!-- Overhead RGB-D Camera Sensor -->
  <gazebo reference="overhead_camera_link">
    <material>
      <ambient>0.18 0.18 0.18 1.0</ambient>
      <diffuse>0.18 0.18 0.18 1.0</diffuse>
      <specular>0.4 0.4 0.4 1.0</specular>
    </material>
    <sensor name="overhead_rgbd_camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.2</near>
          <far>4.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>/overhead_camera/depth</topic>
      <gz_frame_id>overhead_camera_link</gz_frame_id>
    </sensor>
  </gazebo>
  <!-- End-Effector Close-Range RGB-D Camera Sensor -->
  <gazebo reference="ee_camera_link">
    <material>
      <ambient>0.18 0.18 0.18 1.0</ambient>
      <diffuse>0.18 0.18 0.18 1.0</diffuse>
      <specular>0.4 0.4 0.4 1.0</specular>
    </material>
    <sensor name="ee_rgbd_camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>2.35</horizontal_fov>
        <image>
          <width>320</width>
          <height>320</height>
        </image>
        <clip>
          <near>0.01</near>
          <far>0.40</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>20</update_rate>
      <visualize>true</visualize>
      <topic>/ee_camera/depth</topic>
      <gz_frame_id>ee_camera_link</gz_frame_id>
    </sensor>
  </gazebo>
  <!-- Gazebo Sensors System Plugin (OGRE 2 Engine) -->
  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Joint State Publisher for TF2 / robot_state_publisher -->
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>base_to_part_2</joint_name>
      <joint_name>part_2_to_part_3</joint_name>
      <joint_name>part_3_to_part_4__3</joint_name>
      <joint_name>part_4__3_to_part_4</joint_name>
