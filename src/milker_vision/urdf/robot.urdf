      <origin rpy="0 0 0" xyz="0 0 -0.055"/>
      <geometry>
        <sphere radius="0.012"/>
      </geometry>
    </collision>
    <!-- 4. Distal Streak Canal / Papillary Orifice (Marks the EXACT tip apex) -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.06652"/>
      <geometry>
        <cylinder length="0.002" radius="0.0042"/>
      </geometry>
      <material name="streak_canal_dark"/>
    </visual>
    <inertial>
      <mass value="0.04"/>
      <origin xyz="0 0 -0.0275"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <joint name="teat_fr_joint" type="fixed">
    <parent link="quarter_fr"/>
    <child link="teat_fr_link"/>
    <origin rpy="0 0 -0.08" xyz="0.0 0.0 -0.095"/>
  </joint>
  <gazebo reference="teat_fr_link">
    <material>
      <ambient>0.90 0.54 0.58 1.0</ambient>
      <diffuse>0.90 0.54 0.58 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
    </material>
  </gazebo>
  <link name="teat_rl_link">
    <!-- 1. Gland Cistern Base Taper (smooth anatomical transition into udder floor) -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.007"/>
      <geometry>
        <cylinder length="0.014" radius="0.0143"/>
      </geometry>
      <material name="udder_skin"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.007"/>
      <geometry>
        <cylinder length="0.014" radius="0.0143"/>
      </geometry>
    </collision>
    <!-- 2. Main Teat Barrel -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.024"/>
      <geometry>
        <cylinder length="0.048" radius="0.011"/>
      </geometry>
      <material name="teat_skin"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.024"/>
      <geometry>
        <cylinder length="0.048" radius="0.011"/>
      </geometry>
    </collision>
    <!-- 3. Anatomical Rounded Distal Tip Cap (Hemisphere Dome) -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.048"/>
      <geometry>
        <sphere radius="0.011"/>
      </geometry>
      <material name="teat_skin"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.048"/>
      <geometry>
        <sphere radius="0.011"/>
      </geometry>
    </collision>
    <!-- 4. Distal Streak Canal / Papillary Orifice (Marks the EXACT tip apex) -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.05856"/>
      <geometry>
        <cylinder length="0.002" radius="0.0038499999999999997"/>
      </geometry>
      <material name="streak_canal_dark"/>
    </visual>
    <inertial>
      <mass value="0.04"/>
      <origin xyz="0 0 -0.024"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <joint name="teat_rl_joint" type="fixed">
    <parent link="quarter_rl"/>
    <child link="teat_rl_link"/>
    <origin rpy="0 0 -0.04" xyz="0.0 0.0 -0.105"/>
  </joint>
  <gazebo reference="teat_rl_link">
    <material>
      <ambient>0.90 0.54 0.58 1.0</ambient>
      <diffuse>0.90 0.54 0.58 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
    </material>
  </gazebo>
  <link name="teat_rr_link">
    <!-- 1. Gland Cistern Base Taper (smooth anatomical transition into udder floor) -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.007"/>
      <geometry>
        <cylinder length="0.014" radius="0.0143"/>
      </geometry>
      <material name="udder_skin"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.007"/>
      <geometry>
        <cylinder length="0.014" radius="0.0143"/>
      </geometry>
    </collision>
    <!-- 2. Main Teat Barrel -->
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.024"/>
      <geometry>
        <cylinder length="0.048" radius="0.011"/>
      </geometry>
      <material name="teat_skin"/>
    </visual>
