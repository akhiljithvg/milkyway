      <joint_name>part_4__2_to_part_5</joint_name>
      <joint_name>part_5_to_part_2_3</joint_name>
    </plugin>
    <!-- Joint Position Controllers for 7-DOF Milking Arm -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>base_to_part_2</joint_name>
      <topic>/arm/base_to_part_2/cmd_pos</topic>
      <p_gain>1000.0</p_gain>
      <i_gain>50.0</i_gain>
      <d_gain>80.0</d_gain>
      <initial_position>0.0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
