  <joint name="teat_rr_joint" type="fixed">
    <parent link="quarter_rr"/>
    <child link="teat_rr_link"/>
    <origin rpy="0 0 0.04" xyz="0.0 0.0 -0.105"/>
  </joint>
  <gazebo reference="teat_rr_link">
    <material>
      <ambient>0.90 0.54 0.58 1.0</ambient>
      <diffuse>0.90 0.54 0.58 1.0</diffuse>
      <specular>0.2 0.2 0.2 1.0</specular>
    </material>
  </gazebo>
  <!-- ======================================================== -->
  <!-- 7A. OVERHEAD RGB-D CAMERA (COARSE COW & UDDER TRACKING)  -->
  <!-- Mounted directly above cow spine at Z=2.30m looking down -->
  <!-- ======================================================== -->
  <link name="overhead_camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="d435_gray"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>
  <joint name="world_to_overhead_camera" type="fixed">
    <parent link="world"/>
    <child link="overhead_camera_link"/>
    <!-- Directly above cow's back, pitched +90 deg so +X optical axis points straight down (-Z world) -->
    <origin rpy="0 1.57079632679 0" xyz="0.35 0.0 2.30"/>
  </joint>
  <link name="overhead_camera_depth_optical_frame"/>
  <joint name="overhead_camera_to_optical" type="fixed">
    <parent link="overhead_camera_link"/>
    <child link="overhead_camera_depth_optical_frame"/>
    <origin rpy="-1.57079632679 0 -1.57079632679" xyz="0 0 0"/>
  </joint>
  <!-- ======================================================== -->
  <!-- 7C. END-EFFECTOR RGB-D CAMERA (CLOSE-RANGE TEAT TRACKING)-->
  <!-- Mounted on 4-cup milker cluster (part_2_3), looking UP   -->
  <!-- ======================================================== -->
  <link name="ee_camera_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.020 0.060 0.020"/>
      </geometry>
      <material name="d435_gray"/>
    </visual>
    <inertial>
      <mass value="0.050"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>
  <joint name="part_2_3_to_ee_camera" type="fixed">
    <parent link="part_2_3"/>
    <child link="ee_camera_link"/>
    <!-- Mounted between the 4 cup rims at top of cluster, pitched -90 deg so +X optical axis looks straight UP (+Z) -->
    <origin rpy="0 -1.57079632679 0" xyz="0.025 0.025 0.115"/>
  </joint>
  <link name="ee_camera_depth_optical_frame"/>
  <joint name="ee_camera_to_optical" type="fixed">
    <parent link="ee_camera_link"/>
    <child link="ee_camera_depth_optical_frame"/>
    <origin rpy="-1.57079632679 0 -1.57079632679" xyz="0 0 0"/>
  </joint>
  <!-- ======================================================== -->
  <!-- 8. GAZEBO HARMONIC SENSOR SYSTEM & PBR MATERIALS         -->
  <!-- ======================================================== -->
  <gazebo reference="model_cow_copy_1___assembly_4__1___configuration_default">
    <material>
      <ambient>0.96 0.94 0.92 1.0</ambient>
      <diffuse>0.96 0.94 0.92 1.0</diffuse>
