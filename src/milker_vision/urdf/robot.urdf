    </material>
  </gazebo>
  <gazebo reference="part_4__2">
    <material>
      <ambient>0.30 0.32 0.36 1.0</ambient>
      <diffuse>0.30 0.32 0.36 1.0</diffuse>
      <specular>0.6 0.6 0.6 1.0</specular>
    </material>
  </gazebo>
  <gazebo reference="part_5">
    <material>
      <ambient>0.65 0.67 0.70 1.0</ambient>
      <diffuse>0.65 0.67 0.70 1.0</diffuse>
      <specular>0.8 0.8 0.8 1.0</specular>
    </material>
  </gazebo>
  <gazebo reference="part_2_3">
    <material>
      <ambient>0.20 0.22 0.25 1.0</ambient>
