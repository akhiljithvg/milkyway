<?xml version="1.0"?>
<robot name="vision_rig" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ======================================================== -->
  <!-- 1. REALISTIC MATERIALS                                   -->
  <!-- ======================================================== -->
  <material name="holstein_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="holstein_white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>
  <material name="udder_skin">
    <!-- Natural bovine udder peach/pink epidermal tone -->
    <color rgba="0.96 0.77 0.72 1.0"/>
  </material>
  <material name="teat_skin">
    <!-- Richer vascularized teat tissue -->
    <color rgba="0.90 0.54 0.58 1.0"/>
  </material>
  <material name="streak_canal_dark">
    <!-- Sphincter / teat orifice indicator -->
    <color rgba="0.72 0.36 0.40 1.0"/>
  </material>
  <material name="stand_metal">
    <color rgba="0.35 0.35 0.40 1.0"/>
  </material>
  <material name="d435_gray">
    <color rgba="0.20 0.20 0.20 1.0"/>
  </material>

  <!-- ======================================================== -->
  <!-- 2. STATIC WORLD ROOT                                     -->
  <!-- ======================================================== -->
  <link name="world"/>

  <!-- ======================================================== -->
  <!-- 3. CAMERA RIG & INTEL REALSENSE D435 SENSOR              -->
  <!-- Placed at Z=0.28m, pitched up (-0.25 rad) for full FOV   -->
  <!-- ======================================================== -->
  <link name="camera_mount">
    <visual>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.28"/>
      </geometry>
      <material name="stand_metal"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.28"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.14"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="world_to_mount" type="fixed">
    <parent link="world"/>
    <child link="camera_mount"/>
    <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
      <material name="d435_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.090 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <joint name="mount_to_camera" type="fixed">
    <parent link="camera_mount"/>
    <child link="camera_link"/>
    <origin xyz="0.0 0.0 0.28" rpy="0 -0.25 0"/>
  </joint>

  <!-- Standard ROS Optical Frame -->
  <link name="camera_depth_optical_frame"/>
  <joint name="camera_to_optical" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_depth_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
  </joint>

  <!-- ======================================================== -->
  <!-- 4. REALISTIC COW ABDOMEN & HINDQUARTERS (MILKING STALL)   -->
  <!-- ======================================================== -->
  <link name="cow_body_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.75 0.46 0.18"/>
      </geometry>
      <material name="holstein_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.75 0.46 0.18"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="45.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.2" ixy="0" ixz="0" iyy="2.5" iyz="0" izz="3.0"/>
    </inertial>
  </link>

  <joint name="world_to_cow_body" type="fixed">
    <parent link="world"/>
    <child link="cow_body_link"/>
    <origin xyz="0.50 0.0 0.65" rpy="0 0 0"/>
  </joint>

  <!-- Bovine Left Hind Leg (Stall framing) -->
  <link name="left_hind_leg">
    <visual>
      <origin xyz="0 0 -0.28" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.56"/>
      </geometry>
      <material name="holstein_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.28" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.56"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="12.0"/>
      <origin xyz="0 0 -0.28"/>
      <inertia ixx="0.35" ixy="0" ixz="0" iyy="0.35" iyz="0" izz="0.06"/>
    </inertial>
  </link>
  <joint name="cow_to_left_leg" type="fixed">
    <parent link="cow_body_link"/>
    <child link="left_hind_leg"/>
    <origin xyz="0.10 0.23 0.0" rpy="0 0 0"/>
  </joint>

  <!-- Bovine Right Hind Leg (Stall framing) -->
  <link name="right_hind_leg">
    <visual>
      <origin xyz="0 0 -0.28" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.56"/>
      </geometry>
      <material name="holstein_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.28" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.065" length="0.56"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="12.0"/>
      <origin xyz="0 0 -0.28"/>
      <inertia ixx="0.35" ixy="0" ixz="0" iyy="0.35" iyz="0" izz="0.06"/>
    </inertial>
  </link>
  <joint name="cow_to_right_leg" type="fixed">
    <parent link="cow_body_link"/>
    <child link="right_hind_leg"/>
    <origin xyz="0.10 -0.23 0.0" rpy="0 0 0"/>
  </joint>

  <!-- ======================================================== -->
  <!-- 5. UDDER SUSPENSORY BASE (FORE/REAR ATTACHMENT BLEND)    -->
  <!-- ======================================================== -->
  <link name="udder_base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.44 0.34 0.06"/>
      </geometry>
      <material name="udder_skin"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.44 0.34 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.5"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.04" ixy="0" ixz="0" iyy="0.06" iyz="0" izz="0.08"/>
    </inertial>
  </link>
  <joint name="cow_to_udder_base" type="fixed">
    <parent link="cow_body_link"/>
    <child link="udder_base_link"/>
    <origin xyz="0.0 0.0 -0.11" rpy="0 0 0"/>
  </joint>

  <!-- ======================================================== -->
  <!-- 6. THE 4 GLANDULAR QUARTERS (ANATOMICAL LOBES & CLEFT)   -->
  <!-- Left and Right quarters separated by Median Suspensory   -->
  <!-- ======================================================== -->
  <xacro:macro name="quarter_lobe" params="name x y z radius mass">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
        <material name="udder_skin"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${mass}"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.015"/>
      </inertial>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="udder_base_link"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${name}">
      <material>
        <ambient>0.96 0.77 0.72 1.0</ambient>
        <diffuse>0.96 0.77 0.72 1.0</diffuse>
        <specular>0.15 0.15 0.15 1.0</specular>
      </material>
    </gazebo>
  </xacro:macro>

  <!-- Fore Quarters (42% volume, forward abdominal slope) -->
  <xacro:quarter_lobe name="quarter_fl" x="-0.070" y="0.075" z="-0.05" radius="0.105" mass="2.2"/>
  <xacro:quarter_lobe name="quarter_fr" x="-0.070" y="-0.075" z="-0.05" radius="0.105" mass="2.2"/>

  <!-- Rear Quarters (58% volume, fuller posterior lobes) -->
  <xacro:quarter_lobe name="quarter_rl" x="0.065"  y="0.055" z="-0.04" radius="0.115" mass="2.8"/>
  <xacro:quarter_lobe name="quarter_rr" x="0.065"  y="-0.055" z="-0.04" radius="0.115" mass="2.8"/>

  <!-- ======================================================== -->
  <!-- 7. ANATOMICAL TEATS WITH SPHINCTER TIP ORIFICES           -->
  <!-- ======================================================== -->
  <xacro:macro name="anatomical_teat" params="prefix parent x y z roll length radius">
    <link name="${prefix}_link">
      <!-- 1. Gland Cistern Base Taper -->
      <visual>
        <origin xyz="0 0 -0.007" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius * 1.30}" length="0.014"/>
        </geometry>
        <material name="udder_skin"/>
      </visual>
      <collision>
        <origin xyz="0 0 -0.007" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius * 1.30}" length="0.014"/>
        </geometry>
      </collision>

      <!-- 2. Main Teat Barrel -->
      <visual>
        <origin xyz="0 0 -${length / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
        <material name="teat_skin"/>
      </visual>
      <collision>
        <origin xyz="0 0 -${length / 2}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius}" length="${length}"/>
        </geometry>
      </collision>

      <!-- 3. Anatomical Rounded Distal Tip Cap (Hemisphere Dome) -->
      <visual>
        <origin xyz="0 0 -${length}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
        <material name="teat_skin"/>
      </visual>
      <collision>
        <origin xyz="0 0 -${length}" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
      </collision>

      <!-- 4. Distal Streak Canal / Orifice (Marking the EXACT tip apex) -->
      <visual>
        <origin xyz="0 0 -${length + radius * 0.96}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${radius * 0.35}" length="0.002"/>
        </geometry>
        <material name="streak_canal_dark"/>
      </visual>

      <inertial>
        <mass value="0.04"/>
        <origin xyz="0 0 -${length / 2}"/>
        <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
      </inertial>
    </link>

    <joint name="${prefix}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="0 0 ${roll}"/>
    </joint>

    <gazebo reference="${prefix}_link">
      <material>
        <ambient>0.90 0.54 0.58 1.0</ambient>
        <diffuse>0.90 0.54 0.58 1.0</diffuse>
        <specular>0.2 0.2 0.2 1.0</specular>
      </material>
    </gazebo>
  </xacro:macro>

  <!-- Fore Teats: length=5.5cm, radius=1.2cm (wider 15cm inter-teat placement) -->
  <xacro:anatomical_teat prefix="teat_fl" parent="quarter_fl" x="0.0" y="0.0" z="-0.095" roll="0.08" length="0.055" radius="0.012"/>
  <xacro:anatomical_teat prefix="teat_fr" parent="quarter_fr" x="0.0" y="0.0" z="-0.095" roll="-0.08" length="0.055" radius="0.012"/>

  <!-- Rear Teats: length=4.8cm, radius=1.1cm (narrower 11cm placement) -->
  <xacro:anatomical_teat prefix="teat_rl" parent="quarter_rl" x="0.0" y="0.0" z="-0.105" roll="-0.04" length="0.048" radius="0.011"/>
  <xacro:anatomical_teat prefix="teat_rr" parent="quarter_rr" x="0.0" y="0.0" z="-0.105" roll="0.04" length="0.048" radius="0.011"/>

  <!-- ======================================================== -->
  <!-- 8. GAZEBO HARMONIC SENSOR & SENSORS SYSTEM PLUGIN        -->
  <!-- ======================================================== -->
  <gazebo reference="camera_mount">
    <material>
      <ambient>0.35 0.35 0.40 1.0</ambient>
      <diffuse>0.35 0.35 0.40 1.0</diffuse>
      <specular>0.6 0.6 0.6 1.0</specular>
    </material>
  </gazebo>

  <gazebo reference="camera_link">
    <material>
      <ambient>0.20 0.20 0.20 1.0</ambient>
      <diffuse>0.20 0.20 0.20 1.0</diffuse>
      <specular>0.4 0.4 0.4 1.0</specular>
    </material>
    <sensor name="rgbd_camera" type="rgbd_camera">
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>5.0</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>/camera/depth</topic>
      <gz_frame_id>camera_link</gz_frame_id>
    </sensor>
  </gazebo>

  <gazebo reference="cow_body_link">
    <material>
      <ambient>0.08 0.08 0.08 1.0</ambient>
      <diffuse>0.08 0.08 0.08 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="left_hind_leg">
    <material>
      <ambient>0.95 0.95 0.95 1.0</ambient>
      <diffuse>0.95 0.95 0.95 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="right_hind_leg">
    <material>
      <ambient>0.95 0.95 0.95 1.0</ambient>
      <diffuse>0.95 0.95 0.95 1.0</diffuse>
    </material>
  </gazebo>
  <gazebo reference="udder_base_link">
    <material>
      <ambient>0.96 0.77 0.72 1.0</ambient>
      <diffuse>0.96 0.77 0.72 1.0</diffuse>
    </material>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
  </gazebo>

</robot>
